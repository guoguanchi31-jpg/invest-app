COMPOSE_PROJECT_NAME=invest
APP_ENV=production
DOMAIN=finance.example.com
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_DB=invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_VALUE

APP_PASSWORD=CHANGE_ME_SET_A_LOGIN_PASSWORD
APP_USERNAME=admin
APP_USER_NAME=家庭管理员
APP_FAMILY_NAME=我的家庭
APP_AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
AUTH_TOKEN_TTL_SECONDS=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_TRACKED_IDENTITIES=10000
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
FINANCIAL_COMMAND_RESPONSE_RETENTION_DAYS=90
FINANCIAL_COMMAND_RETENTION_BATCH_SIZE=250
ENABLE_SNAPSHOT_SCHEDULER=1
ALLOWED_ORIGINS=https://finance.example.com,capacitor://localhost,http://localhost,https://localhost
BASE_CURRENCY=CNY
BUSINESS_TIMEZONE=Asia/Shanghai

VITE_USER_NAME=冠池
VITE_USER_BADGE=个人理财空间
SEED_DEMO_DATA=0
TZ=Asia/Shanghai

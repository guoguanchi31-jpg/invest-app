{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "simulator": "VITE_INCLUDE_SIMULATOR=1 node scripts/dev.mjs --open /simulator.html",
    "build": "vite build",
    "build:simulator": "VITE_INCLUDE_SIMULATOR=1 vite build",
    "verify:build": "npm run build && node scripts/verify-production-build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/real-api-e2e.mjs",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^5.0.2"
  }
}
